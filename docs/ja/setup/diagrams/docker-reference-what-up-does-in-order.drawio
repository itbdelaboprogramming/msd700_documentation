<mxfile host="msd700-docs">
  <diagram id="d" name="upの動作順">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="--build時: ロボットイメージビルド&lt;br&gt;シミュレーター時: ワールド資産確&lt;br&gt;保" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="246" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="クラウド宛先・ROSポート・&lt;br&gt;キャッシュID・ホスト指紋を解決" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="25" y="135" width="236" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="トークンファイル確保、&lt;br&gt;停止中ならロボットコンテナ起動" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="25" y="234" width="236" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="重複robot_pose_publisherの&lt;br&gt;CATKIN_IGNORE標識を整合" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="36" y="333" width="213" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="local_up: シークレット・メディア&lt;br&gt;dir・&lt;br&gt;リポジトリパス・ローカルIP" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="432" width="246" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="ローカルイメージ欠落か--buildでビ&lt;br&gt;ルド。&lt;br&gt;他は旧版なら警告" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="547" width="246" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="compose --profile local_dev up -d --&lt;br&gt;no-build" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="662" width="246" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="除外指定なければ自動起動を有効&lt;br&gt;化" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="761" width="246" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="docker exec run_msd.sh:&lt;br&gt;必要ならワークスペースビルド、&lt;br&gt;tmuxセッション置換・サービス起&lt;br&gt;動" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
