<mxfile host="msd700-docs">
  <diagram id="d" name="What up does, in order">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="If --build: build robot image&lt;br&gt;If simulator: ensure world assets" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="29" y="20" width="228" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Resolve cloud endpoint, ROS port,&lt;br&gt;cached identity, host fingerprint" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="23" y="119" width="241" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Ensure token file,&lt;br&gt;start robot container if stopped" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="34" y="218" width="218" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Reconcile duplicate&lt;br&gt;robot_pose_publisher&lt;br&gt;CATKIN_IGNORE marker" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="318" width="246" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="local_up: secrets, media dir,&lt;br&gt;repo paths, local IP" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="41" y="432" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Build local images if missing or --&lt;br&gt;build;&lt;br&gt;else warn if stale" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="532" width="246" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="compose --profile local_dev up -d --&lt;br&gt;no-build" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="646" width="246" height="60" as="geometry" />
