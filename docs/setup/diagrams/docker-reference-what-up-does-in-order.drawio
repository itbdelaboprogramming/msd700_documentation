          <mxGeometry x="26" y="746" width="235" height="43" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="docker exec run_msd.sh:&lt;br&gt;build workspace if needed,&lt;br&gt;replace tmux session, launch&lt;br&gt;services" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
