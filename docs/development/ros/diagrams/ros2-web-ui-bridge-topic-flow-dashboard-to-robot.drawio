<mxfile host="msd700-docs">
  <diagram id="d" name="ROS 2 Web UI bridge: topic flow from dashboard to robot">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dash" value="ROS Web UI dashboard and backend" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m" value="MQTT in, cloud and local brokers: /unit_&amp;lt;ULID&amp;gt;/...&lt;br&gt;system_command: hardware, emergency_stop, manual, follower, rth&lt;br&gt;string/key_vel, string/map_request" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="640" height="64" as="geometry" />
        </mxCell>
        <mxCell id="w" value="webui_bridge&lt;br&gt;command router and dedupe, lease, presence watchdog, motion lock (emergency stop survives restart),&lt;br&gt;manual channel, goal gate for follower and RTH, launch layers" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tm" value="twist_mux&lt;br&gt;lock 255, teleop 100,&lt;br&gt;webui 90, nav/cmd_vel 10" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="370" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="nav" value="cmu_nav_executor&lt;br&gt;(navigation stack)" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="370" y="370" width="120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="rth" value="msd_rth&lt;br&gt;return_to_home&lt;br&gt;(answers on webui/rth/&lt;br&gt;status and way_point)" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="510" y="370" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mg" value="motion_guard&lt;br&gt;20 Hz, zero unless lock released, heartbeat &amp;lt; 0.6 s, input &amp;lt; 0.3 s, sole publisher" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="lay" value="launch layers the bridge&lt;br&gt;starts and stops:&lt;br&gt;hardware_prototype.launch.py,&lt;br&gt;follower.launch.py, rth.launch.py" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="500" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hw" value="hardware_interface_node, MCU" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="system_feedback back to MQTT;&lt;br&gt;webui/watchdog_status and&lt;br&gt;webui/guard_state for debugging" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="620" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;startArrow=none;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dash" target="m">
          <mxGeometry relative="1" as="geometry" />
