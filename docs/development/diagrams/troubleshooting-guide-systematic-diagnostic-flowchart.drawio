        <mxCell id="n1" value="Identify Engineering Symptom" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="69" y="20" width="216" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Does the unit show Online&lt;br&gt;in the Web Console?" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rhombus;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="78" y="104" width="199" height="199" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Check MQTT Layer:&lt;br&gt;1. Is HiveMQ CE running (:8883)?&lt;br&gt;2. Is TLS keystore valid&lt;br&gt;(/srv/msd/secrets/)?&lt;br&gt;3. Is robot aws_mqtt bridge active?" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="399" width="246" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Do commands execute?&lt;br&gt;(e.g. Manual WASD / Mode Switch)" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rhombus;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="307" y="399" width="247" height="248" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Check Command Layer:&lt;br&gt;1. Is system_command.py running&lt;br&gt;on robot?&lt;br&gt;2. Is HTTP request returning 504&lt;br&gt;Timeout?&lt;br&gt;3. Is lease held by another&lt;br&gt;session?" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="265" y="743" width="246" height="138" as="geometry" />
