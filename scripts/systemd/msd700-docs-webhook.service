[Unit]
Description=MSD700 Docs GitHub webhook listener (auto-deploy on push to main)
After=network.target

[Service]
Type=simple
User=itbdelabo
Group=itbdelabo
WorkingDirectory=/home/itbdelabo/ITBdeLabo/Production/msd700_documentation
EnvironmentFile=/home/itbdelabo/ITBdeLabo/Production/msd700_documentation/scripts/webhook.env
# node is installed via nvm, not /usr/bin/node, update this path if nvm's
# active node version changes (check with: nvm which current)
ExecStart=/home/itbdelabo/.nvm/versions/node/v22.16.0/bin/node scripts/webhook-listener.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
